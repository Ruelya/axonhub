+# Publish self-use multi-arch images for the Codex↔xAI apply_patch bridge branch.
+# Images: ghcr.io/<owner>/axonhub:codex-bridge  (and :sha / :tag)
+name: Docker codex-bridge
+
+on:
+  push:
+    branches:
+      - feat/codex-grok-apply-patch-bridge
+    tags:
+      - 'v*-codex-bridge*'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  packages: write
+
+env:
+  REGISTRY: ghcr.io
+  IMAGE_NAME: ${{ github.repository }}
+
+jobs:
+  build:
+    name: Build & push (${{ matrix.arch }})
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - arch: amd64
+            platform: linux/amd64
+            runner: ubuntu-latest
+          - arch: arm64
+            platform: linux/arm64
+            runner: ubuntu-24.04-arm
+    runs-on: ${{ matrix.runner }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 1
+
+      - name: Keep upstream VERSION (semver)
+        run: |
+          # Do not invent a non-semver build id; UI/migration expect valid versions.
+          test -f internal/build/VERSION
+          echo "VERSION=$(cat internal/build/VERSION)" >> "$GITHUB_ENV"
+          echo "Using VERSION=$(cat internal/build/VERSION)"
+
+      - uses: docker/setup-buildx-action@v3
+
+      - uses: docker/login-action@v3
+        with:
+          registry: ${{ env.REGISTRY }}
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Build & push arch image
+        uses: docker/build-push-action@v6
+        with:
+          context: .
+          platforms: ${{ matrix.platform }}
+          push: true
+          tags: |
+            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:codex-bridge-${{ matrix.arch }}
+            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:sha-${{ github.sha }}-${{ matrix.arch }}
+          cache-from: type=gha,scope=codex-bridge-${{ matrix.arch }}
+          cache-to: type=gha,mode=max,scope=codex-bridge-${{ matrix.arch }}
+          provenance: false
+          sbom: false
+
+  manifest:
+    name: Multi-arch manifest
+    needs: [build]
+    runs-on: ubuntu-latest
+    steps:
+      - uses: docker/login-action@v3
+        with:
+          registry: ${{ env.REGISTRY }}
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Create manifest tags
+        env:
+          IMG: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
+        run: |
+          set -euo pipefail
+          # codex-bridge
+          docker buildx imagetools create -t "${IMG}:codex-bridge" \
+            "${IMG}:codex-bridge-amd64" \
+            "${IMG}:codex-bridge-arm64"
+          # commit sha
+          docker buildx imagetools create -t "${IMG}:sha-${GITHUB_SHA}" \
+            "${IMG}:sha-${GITHUB_SHA}-amd64" \
+            "${IMG}:sha-${GITHUB_SHA}-arm64"
+          # optional git tag
+          if [[ "${GITHUB_REF}" == refs/tags/* ]]; then
+            TAG="${GITHUB_REF#refs/tags/}"
+            docker buildx imagetools create -t "${IMG}:${TAG}" \
+              "${IMG}:codex-bridge-amd64" \
+              "${IMG}:codex-bridge-arm64"
+          fi
+          docker buildx imagetools inspect "${IMG}:codex-bridge"
